{
  "name": "keycloak-theme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npx keycloakify start-keycloak",
    "postinstall": "keycloakify sync-extensions",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:keycloakify": "yarn run build && keycloakify build",
    "keycloakify": "keycloakify",
    "build:kc": "node ./scripts/run-build-kc.mjs",
    "build:themes": "node ./scripts/run-build-themes.mjs",
    "build:themes:ci": "node ./scripts/run-build-themes.mjs --non-interactive",
    "lint": "eslint .",
    "preview": "vite preview",
    "build-keycloak-theme": "yarn run build:themes",
    "build-keycloak-theme:ci": "yarn run build:themes:ci",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "flush-keycloak": "rm -rf ./dist_keycloak",
    "eject-page": "keycloakify eject-page",
    "extract-jar": "node extract-jar.js"
  },
  "dependencies": {
    "@keycloakify/login-ui": "~250004.6.5",
    "@oussemasahbeni/keycloakify-login-shadcn": "^250004.0.20",
    "@tailwindcss/vite": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "keycloakify": "^11.15.3",
    "lucide-react": "^0.473.0",
    "radix-ui": "latest",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.5.0",
    "rfc4648": "^1.5.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.2.1",
    "tsafe": "^1.8.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@keycloakify/login-ui-storybook": "~250004.2.0",
    "@storybook/react-vite": "^9.0.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "adm-zip": "^0.5.17",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "storybook": "^9.0.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
